# Every environment variable the freehire binaries read, for the Dokploy Environment tab.
#
# Paste the lines you need into Dokploy (Compose service -> Environment). The compose file
# passes the whole .env through to app, workers, scheduler and migrate, so any key here
# takes effect on the next deploy without editing docker-compose.dokploy.yml. Values
# already set in Dokploy (JWT_SECRET, MEILI_MASTER_KEY, FRONTEND_ORIGIN, WEB_ORIGIN,
# COOKIE_SECURE, LLM_*) stay as they are; do not paste them twice.
#
# Empty means "feature off" for everything marked optional. In-stack services (Postgres,
# Redis, Meilisearch, MinIO, the PII filter) are wired by the compose file and need
# nothing here. Restart (redeploy) after changing anything.

# ============================================================================
# Core (already set on hire.msantoki.com)
# ============================================================================
# Random 32+ bytes. The server refuses to start without it.
JWT_SECRET=
# Session lifetime (default 24h).
# JWT_TTL=24h
# Public origin of the site. OAuth callbacks and every emailed link point here.
FRONTEND_ORIGIN=https://hire.msantoki.com
# Same value, read by the SvelteKit server for canonical URLs / sitemap.
WEB_ORIGIN=https://hire.msantoki.com
# Mandatory with an https:// FRONTEND_ORIGIN.
COOKIE_SECURE=true
# Cookie scope when the site spans subdomains; empty = host-only cookie.
# COOKIE_DOMAIN=
# Hostnames the API answers for, comma-separated; empty = any.
# SERVED_HOSTS=
# Meilisearch master key (also set on the meilisearch service by the compose file).
MEILI_MASTER_KEY=
# "production" switches on production-only behaviour (stricter logging, no dev shortcuts).
# ENV=production
# Prometheus scrape port for the API; empty = metrics off.
# METRICS_PORT=

# ============================================================================
# Email (verification, password reset, alerts, onboarding sequence, digests)
# ============================================================================
# Sender identity. Must be on a domain verified at the mail provider.
# e.g. NOTIFY_EMAIL_FROM="freehire <no-reply@msantoki.com>"
NOTIFY_EMAIL_FROM=
# Option A: Resend (https://resend.com). Verify your domain there, create an API key.
# When set, ALL outbound mail goes through Resend and AWS SES is not used.
RESEND_API_KEY=
# Option B: AWS SES. Region of the verified SES identity plus IAM credentials.
# AWS_REGION is already defaulted to us-east-1 by the compose file for MinIO; only
# change it for SES.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Reply-To for the founder onboarding sequence (cmd/onboarding, cmd/broadcast). Those
# workers stay off until this is set together with NOTIFY_EMAIL_FROM.
# ONBOARDING_REPLY_TO=
# Hosted inbox for applications (inbound SES -> S3 -> SQS). Needs AWS; leave off otherwise.
# MAILBOX_DOMAIN=
# MAIL_INBOUND_QUEUE_URL=
# MAIL_INBOUND_BUCKET=

# ============================================================================
# Sign-in providers (optional; a provider with empty credentials is hidden)
# Callback URL to register: <FRONTEND_ORIGIN>/api/v1/auth/oauth/<provider>/callback
# ============================================================================
# Google: https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# LinkedIn: app with "Sign In with LinkedIn using OpenID Connect"
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
# Apple: Services ID + Team ID + Key ID + base64 of the .p8 key
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=
# Native iOS/Android sign-in and the browser extension (only with the mobile apps / extension).
# APPLE_NATIVE_CLIENT_ID=
# APPLE_GRANT_KEYS=
# APPLE_GRANT_ACTIVE_KEY_ID=
# MOBILE_AUTH_CALLBACKS=
# EXTENSION_REDIRECT_ALLOWLIST=
# AUTH_V2_ENABLED=
# RECENT_AUTH_TTL=

# ============================================================================
# AI (already set: LLM_BASE_URL / LLM_API_KEY / LLM_MODEL)
# Any OpenAI-compatible /v1 endpoint. Unset = AI features off, catalogue still works.
# ============================================================================
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Model for the assistant (tool calling); falls back to LLM_MODEL.
# ASSISTANT_MODEL=
# Model for query-intent parsing in search; falls back to LLM_MODEL.
# SEARCH_INTENT_MODEL=
# Reasoning effort sent as `reasoning_effort` on every call that does not choose its own
# (low | medium | high | xhigh, whatever the gateway accepts). Empty = send nothing.
# Résumé extraction and fit-analysis stage 1 always send "none" (see internal/platform/llm/reasoning.go).
# LLM_REASONING_EFFORT=
# Speech-to-text model for the assistant microphone; empty = no microphone.
# STT_MODEL=
# Realtime voice model for AI interview practice; empty = off.
# REALTIME_MODEL=
# ASSISTANT_MAX_PROMPT=8000
# ASSISTANT_MAX_STEPS=
# LLM_STRICT_SCHEMA=
# Per-user LLM budget / rate limit.
# LLM_USER_MAX_BUDGET=
# LLM_USER_BUDGET_WINDOW=
# LLM_USER_RPM_LIMIT=
# LiteLLM admin API (only for the llm-probe worker).
# LLM_ADMIN_URL=
# LLM_ADMIN_USERNAME=
# LLM_ADMIN_PASSWORD=
# LLM_ADMIN_TEMPLATE_KEY=
# Semantic search embeddings backend (OpenAI-compatible /embeddings). Empty = no vector search.
# EMBED_URL=
# EMBED_API_KEY=
# Langfuse tracing (all three or nothing).
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# PII filter for résumé structuring. The compose file points this at the in-stack service.
# PII_FILTER_URL=http://pii-filter:8099/detect
# Which metered plan features REFUSE over quota: "match,tailor" or "all". Empty = nothing refused.
# PLAN_ENFORCE=

